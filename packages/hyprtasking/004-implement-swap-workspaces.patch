+static int lua_swap_pos(lua_State *L) {
+    const int layer1 = luaL_optinteger(L, 1, -1);
+    const int x1 = luaL_optinteger(L, 2, -1);
+    const int y1 = luaL_optinteger(L, 3, -1);
+    const int layer2 = luaL_optinteger(L, 4, -1);
+    const int x2 = luaL_optinteger(L, 5, -1);
+    const int y2 = luaL_optinteger(L, 6, -1);
+    if (ht_manager == nullptr) {
+        return luaL_error(L, "%s", "ht_manager is null");
+    }
+    PHTVIEW cursor_view = ht_manager->get_view_from_cursor();
+    if (cursor_view == nullptr) {
+        return luaL_error(L, "%s", "cursor_view is null");
+    }
+    if (cursor_view->layout->layout_name() != "grid") {
+        return luaL_error(L, "%s", "layers are only supported in grid layout");
+    }
+    auto *grid = static_cast<HTLayoutGrid*>(cursor_view->layout.get());
+    if (
+            (0 <= layer1) && (layer1 < 1<<24) && (0 <= x1) && (x1 < 1<<20) && (0 <= y1) && (y1 < 1<<20) &&
+            (0 <= layer2) && (layer2 < 1<<24) && (0 <= x2) && (x2 < 1<<20) && (0 <= y2) && (y2 < 1<<20)
+       ) {
+        WORKSPACEID ws1 = grid->slot_workspace(layer1, x1, y1);
+        WORKSPACEID ws2 = grid->slot_workspace(layer2, x2, y2);
+        if ((ws1 == WORKSPACE_INVALID) || (ws2 == WORKSPACE_INVALID)) {
+            return luaL_error(L, "%s", "workspace not found");
+        }
+        grid->swap_workspaces(ws1, ws2);
+        g_pEventManager->postEvent(SHyprIPCEvent{"hyprtaskingworkspacerearange", ""});
+        return 0;
+    } else {
+        return luaL_error(L, "%s", "invalid workspace");
+    }
+}
