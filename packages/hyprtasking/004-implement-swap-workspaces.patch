+void HTLayoutGrid::swap_workspaces(WORKSPACEID ws1, WORKSPACEID ws2) {
+    const auto tmp = ws_slot_cache[ws1];
+    ws_slot_cache[ws1] = ws_slot_cache[ws2];
+    ws_slot_cache[ws2] = tmp;
+    refresh_workspace_cache();
+    const PHLMONITOR monitor = get_monitor();
+    if (monitor == nullptr) {
+        return;
+    }
+    if (monitor->m_activeWorkspace == nullptr) {
+        return;
+    }
+    if ((ws1 == monitor->m_activeWorkspace->m_id)||(ws2 == monitor->m_activeWorkspace->m_id)) {
+        layer = ws_slot_cache[monitor->m_activeWorkspace->m_id].layer;
+        const PHTVIEW par_view = ht_manager->get_view_from_id(view_id);
+        if (par_view == nullptr || par_view->active) {
+            return;
+        }
+        build_overview_layout(HT_VIEW_CLOSED);
+        offset->setValue(-overview_layout[monitor->m_activeWorkspace->m_id].box.pos());
+        scale->setValue(1.f);
+        *offset = -overview_layout[monitor->m_activeWorkspace->m_id].box.pos();
+        *scale = 1.f;
+    }
+}
